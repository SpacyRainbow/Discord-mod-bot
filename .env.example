# Copy this file to .env and fill in real values. Never commit .env itself.

# Get this from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Your server's ID (right-click the server icon -> Copy Server ID, with
# Developer Mode enabled). Used to register slash commands to that one guild
# so they show up instantly instead of waiting up to an hour for a global sync.
GUILD_ID=

# Optional - only needed to play Spotify links (SoundCloud/YouTube/direct
# audio links work with no extra setup). Create a free app at
# https://developer.spotify.com/dashboard -> Create app (redirect URI can be
# anything, e.g. http://localhost/ - it's unused for this) -> copy the
# Client ID and Client Secret. Without these, Spotify links reply with a
# "not configured" message instead of playing.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional - only needed for /mcstatus (Minecraft server status, plus
# Start/Stop/Restart/Console/Whitelist buttons, via Crafty Controller 4).
# CRAFTY_BASE_URL is however you reach Crafty's web UI (e.g.
# https://192.168.1.50:8443). CRAFTY_API_TOKEN comes from Crafty's web UI:
# gear icon -> your user -> pencil/edit icon -> API key tab - it also needs
# Crafty's own COMMANDS permission on a server for the action/console/
# whitelist buttons to work against it. Without these two values, /mcstatus
# replies with a "not configured" message instead of failing.
# CRAFTY_SERVER_ID is optional - if your token can see more than one server,
# /mcstatus <name> picks one by name instead; set this to always default to
# one specific server without naming it every time.
# CRAFTY_CA_BUNDLE is the path to the certificate (or internal CA) Crafty's
# HTTPS listener presents. Self-hosted Crafty usually runs a self-signed cert,
# which the system trust store won't accept - point this at it. That connection
# carries CRAFTY_API_TOKEN, which has full Minecraft console access (/op, /stop),
# so it is verified rather than trusted blindly. Without it, a self-signed setup
# gets a "couldn't reach Crafty" message.
# CRAFTY_INSECURE_TLS=1 disables certificate verification entirely. Last resort
# only - it exposes CRAFTY_API_TOKEN to anyone on the network path, and logs a
# warning every time it's used.
CRAFTY_BASE_URL=
CRAFTY_API_TOKEN=
CRAFTY_SERVER_ID=
CRAFTY_CA_BUNDLE=
CRAFTY_INSECURE_TLS=

# Optional - restricts /mcstatus to one Discord guild ID, so a multi-server
# bot instance can't have Minecraft control used from a server other than
# the one where you actually manage it. Falls back to GUILD_ID if unset,
# and to no restriction at all if neither is set - so a fork of this bot
# run by someone else gets /mcstatus working in whatever server they add it
# to, by default. No guild ID is hardcoded anywhere in the source.
MINECRAFT_GUILD_ID=

# Prefix used if a server hasn't set a custom one via !setconfig
DEFAULT_PREFIX=!

# Path to the SQLite file. Inside Docker this should point at the mounted volume.
DB_PATH=/app/data/bot.db

# DEBUG, INFO, WARNING, or ERROR
LOG_LEVEL=INFO

# Aguiliar - the @ping-me LLM replies (bot/modules/aguiliar.py).
# Points at the llama-server instance dedicated to this bot on the NAS.
# Unset means pings are ignored; the rest of the bot is unaffected.
LLM_BASE_URL=http://llama-server.example:8085/v1
LLM_MODEL=qwen38-27b-stock
# Seconds. Huge on purpose - the model runs on CPU at ~2.3 tokens/sec.
LLM_TIMEOUT_SECONDS=600
